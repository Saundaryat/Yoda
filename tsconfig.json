{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/api/**/*.ts", "apps/crm-mcp/**/*.ts", "packages/**/*.ts", "fixtures/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/browser/**"]
}
