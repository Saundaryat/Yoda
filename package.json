{
  "name": "agent-evals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "docker compose up --build",
    "dev:db": "docker compose up -d --wait db",
    "dev:api": "pnpm --filter @evals/api start:dev",
    "dev:web": "pnpm --filter @evals/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  }
}
