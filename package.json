{
  "name": "hermes-agent-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node --experimental-strip-types scripts/start.ts",
    "review": "node --experimental-strip-types scripts/start.ts --review",
    "verify:fresh": "node --experimental-strip-types scripts/verify-fresh-setup.ts",
    "verify:package": "node --experimental-strip-types scripts/verify-package.ts",
    "verify:startup": "node --import tsx scripts/verify-startup.ts",
    "verify:cancellation": "node --env-file-if-exists=.env --import tsx scripts/verify-cancellation.ts",
    "verify:crash": "node --env-file-if-exists=.env --import tsx scripts/verify-crash.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test:web": "playwright test --config tests/browser/playwright.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "api": "node --env-file-if-exists=.env --import tsx apps/api/main.ts",
    "db:up": "docker compose up -d --wait db",
    "verify:backend": "node --env-file-if-exists=.env --import tsx scripts/verify-backend.ts",
    "regrade": "node --import tsx scripts/regrade-backend.ts",
    "reconcile:provider": "node --env-file-if-exists=.env --import tsx scripts/reconcile-provider-errors.ts",
    "summarize": "node --import tsx scripts/summarize-experiment.ts",
    "package:submission": "node --import tsx scripts/package-submission.ts",
    "experiment": "node --env-file-if-exists=.env --import tsx scripts/run-comparison.ts",
    "record:demo": "node --import tsx scripts/record-demo.ts",
    "verify:hermes": "node --experimental-strip-types scripts/verify-hermes.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.2",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vue": "3.5.22",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "vite": "7.1.10",
    "@vitejs/plugin-vue": "6.0.1",
    "vue-tsc": "3.1.1",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3"
  }
}
