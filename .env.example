# Copy to .env (never committed) and fill in what you use. Restart with: docker compose up -d --build

# Model keys for the agent under test (Hermes). A configuration's provider picks which one is used.
OPENAI_API_KEY=
# Also used by the LLM-played lead (experiments with "Who plays the lead: LLM").
ANTHROPIC_API_KEY=

# Optional: the Claude model that plays the lead (default claude-opus-5-5).
# LEAD_MODEL=claude-haiku-4-5
# Optional: the Claude model that judges every reply after a run (default claude-sonnet-5-5).
# Pick a different model from the agent under test so nothing grades its own output.
# JUDGE_MODEL=claude-sonnet-5-5

# Optional but recommended for final experiments: Jev classifies each verified unsupported claim
# as minor or serious. Without it, the evaluator conservatively treats every such claim as serious.
TYPESAFE_API_KEY=
# Pinned by default so evaluator results do not drift when the jev-latest alias changes.
# JEV_MODEL=jev-1.14.0

# Optional: stop an experiment's remaining runs once its spend passes this many dollars (default 25).
# MAX_EXPERIMENT_COST_USD=25
