# Copy to .env (never committed) and fill in what you use. Restart with: docker compose up -d --build

# Model keys for the agent under test (Hermes). A configuration's provider picks which one is used.
OPENAI_API_KEY=
# Also used by the LLM-played lead (experiments with "Who plays the lead: LLM").
ANTHROPIC_API_KEY=

# Optional: the Claude model that plays the lead (default claude-opus-5-5).
# LEAD_MODEL=claude-haiku-4-5

# Optional: stop an experiment's remaining runs once its spend passes this many dollars (default 25).
# MAX_EXPERIMENT_COST_USD=25
